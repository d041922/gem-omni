# Environment profiles
# - Minimal UI run [required]: APP_PASSWORD, and one of GOOGLE_API_KEY or GEMINI_API_KEY
# - Full feature run [optional add-ons]: Tavily/Exa/Finnhub/FRED/GCP/KIS keys

# Core runtime
# [optional] locale and terminal behavior
LANG=ko_KR.UTF-8
LC_ALL=ko_KR.UTF-8
LC_CTYPE=UTF-8
NODE_ENV=production
FORCE_COLOR=1
TERM=xterm-256color
MCP_LOG_FORMAT=plain
CREWAI_TELEMETRY_OPT_OUT=true

# LLM / Search APIs
# [required: choose one] GOOGLE_API_KEY or GEMINI_API_KEY
GOOGLE_API_KEY=
GEMINI_API_KEY=
# [optional]
TAVILY_API_KEY=
EXA_API_KEY=
OPENAI_API_KEY=

# Data providers
# [optional]
FINNHUB_API_KEY=
FRED_API_KEY=
DOCAI_PROCESSOR_ID=

# App auth
# [required]
APP_PASSWORD=

# Google service account (choose one approach)
# [optional]
GCP_SERVICE_ACCOUNT_JSON_B64=
GCP_SERVICE_ACCOUNT_JSON=

# Split fields fallback (optional if JSON is not used)
GCP_SERVICE_ACCOUNT_TYPE=service_account
GCP_PROJECT_ID=
GCP_PRIVATE_KEY_ID=
GCP_PRIVATE_KEY=
GCP_CLIENT_EMAIL=
GCP_CLIENT_ID=
GCP_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GCP_TOKEN_URI=https://oauth2.googleapis.com/token
GCP_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GCP_CLIENT_X509_CERT_URL=

# KIS integration (optional)
KIS_PAPER_TRADING=true
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
